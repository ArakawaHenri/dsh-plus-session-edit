{
  "name": "@dshplus/session-edit",
  "version": "0.0.1",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "DSH Plus · Session Edit: Edit and retry historical messages in place, and continue interrupted sessions.",
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.1-rc.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "remote.js",
    "client.js",
    "lib/",
    "src/",
    "scripts/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-client.js",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "test:browser": "node --test test/browser.test.js",
    "test:runtime": "node --test test/service-runtime.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-remote-access",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection-cache": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-query": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-title": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-json": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "clsx": "2.1.1",
    "esbuild": "^0.25.0",
    "immer": "10.1.1",
    "playwright": "^1.56.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "semver": "7.8.5",
    "zustand": "4.5.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArakawaHenri/dshplus-session-edit.git"
  },
  "bugs": {
    "url": "https://github.com/ArakawaHenri/dshplus-session-edit/issues"
  },
  "homepage": "https://github.com/ArakawaHenri/dshplus-session-edit#readme",
  "icon": "./icon.svg"
}
